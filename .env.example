# =============================================================================
# BOILERPLATE - Environment Configuration
# =============================================================================
# Compartilhado por Docker Compose e Laravel 12

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Boilerplate"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Port exposed by Nginx
APP_PORT=80

# Localization
APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=boilerplate
DB_USERNAME=boilerplate
DB_PASSWORD=secret

# Host port to reach Postgres from outside Docker.
# Separate from DB_PORT, which is the port used inside the Compose network.
DB_HOST_PORT=5432

# =============================================================================
# PGADMIN
# =============================================================================
PGADMIN_EMAIL=admin@boilerplate.local
PGADMIN_PASSWORD=secret
PGADMIN_PORT=5050

# =============================================================================
# CACHE & SESSION (Redis)
# =============================================================================
CACHE_STORE=redis
CACHE_PREFIX=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# =============================================================================
# QUEUE (Redis + Horizon)
# =============================================================================
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90

HORIZON_PREFIX=boilerplate_horizon:

# =============================================================================
# BROADCASTING (Reverb)
# =============================================================================
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=boilerplate
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=localhost
REVERB_BACKEND_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# =============================================================================
# REDIS
# =============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Host port to reach Redis from outside Docker.
REDIS_HOST_PORT=6379

# =============================================================================
# FILESYSTEM (RustFS)
# =============================================================================
FILESYSTEM_DISK=local

RUSTFS_ENDPOINT=http://rustfs:9000        # Internal Docker network URL
RUSTFS_PUBLIC_URL=http://localhost:9000   # Browser-accessible URL
RUSTFS_ACCESS_KEY=boilerplate
RUSTFS_SECRET_KEY=secret123456
RUSTFS_BUCKET=boilerplate
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_USE_PATH_STYLE_ENDPOINT=true
RUSTFS_REGION=us-east-1

# AWS S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@boilerplate.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
PENNANT_STORE=database
FEATURES_FIRST_DEPLOY_DATE=

# =============================================================================
# VITE
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
